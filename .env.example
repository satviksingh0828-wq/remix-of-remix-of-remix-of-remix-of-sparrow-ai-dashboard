# Copy this file to .env and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API

# Client-side (public — safe to expose in browser bundles)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side (same URL/publishable key for SSR middleware)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side only — NEVER expose this to the client
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server-side email alerts (Resend). Both admin addresses receive every admin email.
RESEND_API_KEY=re_your_key_here
NOTIFIER_EMAIL=alerts@your-verified-domain.com
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_2_ALERT_EMAIL=second-admin@example.com
CRON_SECRET=your-random-cron-secret
