# Copy this file to .env and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API

# Client-side (public — safe to expose in browser bundles)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side (same URL/publishable key for SSR middleware)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side only — NEVER expose this to the client
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
